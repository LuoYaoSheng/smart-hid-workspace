# Smart HID Firmware — 默认 sdkconfig（仅列 Smart HID 相关与关键覆盖项）
# 完整配置由 `idf.py menuconfig` / `idf.py build` 生成。

# === Target ===
CONFIG_IDF_TARGET="esp32s3"

# === Flash Size（ESP32-S3 常见 8MB flash；partition 表需 factory+ota_0+ota_1 共 3MB+）===
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# === Partition Table ===
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# === USB TinyUSB ===
# Composite HID（Keyboard + Mouse）
# esp_tinyusb managed component（main/idf_component.yml 拉取）。
# 启用 2 个 HID interface（keyboard + mouse），CFG_TUD_HID 由它驱动。
CONFIG_TINYUSB_HID_COUNT=1

# === FreeRTOS ===
CONFIG_FREERTOS_HZ=1000

# === LWIP / MQTT ===
CONFIG_MQTT_TASK_STACK_SIZE=6144

# === NVS Encryption ===
# F4 才启用，F1/F2 保持默认（无加密）
# CONFIG_NVS_ENCRYPTION=y

# === Compiler（M1-G3：BLE+HTTP 组件使固件超 1M，启用 -Os） ===
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# === Logging ===
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# === PSRAM（ESP32-S3-N8R2 模组） ===
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# === BLE Provisioning（M1-G3，NimBLE） ===
# 选型：NimBLE（体积 ~Bluedroid 1/3、ESP-IDF 官方维护、peripheral-only 足够）。
# V1 简化：业务流程不发起 SMP/bonding，Provision Input 为明文 write。
# NimBLE SMP 参数仅保留默认兼容面；明文风险见 PROVISIONING_V1.md §7。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# === 电源管理（2026-09-18，HARDENING_BACKLOG 电源二件套） ===
# USB 总线挂起/恢复回调：宿主睡眠 → 跟随转 Wi-Fi modem sleep；
# 宿主恢复 → 回 WIFI_PS_NONE。开启后 esp_tinyusb 强实现
# tud_suspend_cb/tud_resume_cb 并经 event_cb 派发（应用不得再自定义）。
CONFIG_TINYUSB_SUSPEND_CALLBACK=y
CONFIG_TINYUSB_RESUME_CALLBACK=y
